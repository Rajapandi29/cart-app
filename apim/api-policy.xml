
<policies>
  <inbound>
    <base />

    <validate-jwt
      header-name="Authorization"
      require-scheme="Bearer"
      failed-validation-httpcode="401"
      failed-validation-error-message="Unauthorized">

      <openid-config
        url="https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0/.well-known/openid-configuration" />

      <audiences>
        <audience>api://YOUR_APIM_API_APP_ID</audience>
      </audiences>
    </validate-jwt>

    <rate-limit-by-key
      calls="120"
      renewal-period="60"
      counter-key="@(context.Request.IpAddress)" />

    <choose>
      <when condition="@(!context.Request.Headers.ContainsKey(&quot;X-App-User-Id&quot;) &amp;&amp; context.Request.Url.Path.Contains(&quot;orders&quot;))">
        <return-response>
          <set-status code="401" reason="User required" />
        </return-response>
      </when>
    </choose>

    <set-header name="x-functions-key" exists-action="override">
      <value>{{function-host-key}}</value>
    </set-header>

    <set-backend-service
      base-url="https://YOUR_FUNCTION_APP.azurewebsites.net/api" />

    <set-header name="X-App-User-Id" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("X-App-User-Id", ""))</value>
    </set-header>

    <set-header name="X-App-Admin" exists-action="override">
      <value>@(context.Request.Headers.GetValueOrDefault("X-App-Admin", "false"))</value>
    </set-header>
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
    <set-header name="Cache-Control" exists-action="override">
      <value>no-store</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>
